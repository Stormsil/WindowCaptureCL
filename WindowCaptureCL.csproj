<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>WindowCaptureCL</AssemblyName>
    <RootNamespace>WindowCaptureCL</RootNamespace>

    <!-- Version Information -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Self-Contained Publishing Settings -->
    <PublishSelfContained>true</PublishSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- ILRepack Settings for DLL Merging -->
    <ILRepackEnabled>false</ILRepackEnabled>
    <ILRepackInternalize>true</ILRepackInternalize>
    <ILRepackRenameInternalized>true</ILRepackRenameInternalized>

    <!-- NuGet Package Metadata -->
    <PackageId>WindowCaptureCL</PackageId>
    <Authors>WindowCaptureCL Contributors</Authors>
    <Company>WindowCaptureCL</Company>
    <Product>WindowCaptureCL</Product>
    <Description>High-performance .NET library for capturing screenshots from windows, monitors, and screen regions using Windows Graphics Capture API. Supports single-frame and continuous capture with FPS control, hardware acceleration via DirectX 11, and capture of obscured windows.</Description>
    <PackageTags>screen-capture;screenshot;windows-graphics-capture;directx;capture;recording;window-capture;monitor-capture</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/windowcapturecl/windowcapturecl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/windowcapturecl/windowcapturecl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with window, monitor, and region capture support.</PackageReleaseNotes>
    <Copyright>Copyright © 2025 WindowCaptureCL Contributors</Copyright>

    <!-- Assembly Attributes -->
    <AssemblyTitle>WindowCaptureCL</AssemblyTitle>
    <AssemblyDescription>Windows Graphics Capture Library</AssemblyDescription>
    <AssemblyCompany>WindowCaptureCL Contributors</AssemblyCompany>
    <AssemblyProduct>WindowCaptureCL</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2025 WindowCaptureCL Contributors</AssemblyCopyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Новая папка\**" />
    <EmbeddedResource Remove="Новая папка\**" />
    <None Remove="Новая папка\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="nul" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.Win32" Version="2.3.0" />
    <PackageReference Include="ILRepack.MSBuild.Task" Version="2.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- ILRepack Target for Merging Dependencies -->
  <Target Name="MergeDependencies" AfterTargets="Build" Condition="'$(ILRepackEnabled)' == 'true' AND '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ILRepackPath>$(NuGetPackageRoot)ilrepack.msbuild.task\2.0.13\tools\ILRepack.exe</ILRepackPath>
      <MergedAssembly>$(TargetDir)$(AssemblyName).Merged.dll</MergedAssembly>
    </PropertyGroup>

    <ItemGroup>
      <MergeAssemblies Include="$(TargetPath)" />
      <MergeAssemblies Include="$(TargetDir)Vortice.Direct3D11.dll" />
      <MergeAssemblies Include="$(TargetDir)Vortice.DirectX.dll" />
      <MergeAssemblies Include="$(TargetDir)Vortice.DXGI.dll" />
      <MergeAssemblies Include="$(TargetDir)Vortice.Mathematics.dll" />
      <MergeAssemblies Include="$(TargetDir)Vortice.Win32.dll" />
    </ItemGroup>

    <Exec Command="&quot;$(ILRepackPath)&quot; /out:&quot;$(MergedAssembly)&quot; /wildcards /parallel /union /ndebug /copyattrs /allowMultiple /internalize /targetplatform:v4 /xmldocs /usefullpublickeyforreferences %(MergeAssemblies.FullPath)" Condition="Exists('$(ILRepackPath)')" />

    <Copy SourceFiles="$(MergedAssembly)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" Condition="Exists('$(MergedAssembly)')" />
    <Move SourceFiles="$(MergedAssembly)" DestinationFiles="$(TargetDir)$(AssemblyName).dll" OverwriteReadOnlyFiles="true" Condition="Exists('$(MergedAssembly)')" />
  </Target>

  <!-- Self-Contained Publish Target -->
  <Target Name="PublishSelfContainedDll" AfterTargets="Publish">
    <Message Text="Publishing self-contained DLL to: $(PublishDir)" Importance="high" />
    <Message Text="Assembly Version: $(Version)" Importance="high" />
  </Target>

</Project>
